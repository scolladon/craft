{
  "testRunner": "tap",
  "coverageAnalysis": "perTest",
  "tap": {
    "testFiles": [
      "engine/test/**/*.test.js",
      "adapters/codex/test/apply-patch-paths.test.js",
      "adapters/codex/test/execpolicy-rules.test.js",
      "adapters/codex/test/git-guard-adapter.test.js",
      "adapters/copilot/test/git-guard-adapter.test.js",
      "adapters/opencode/test/git-guard-adapter.test.js",
      "adapters/opencode/test/git-guard-predicate.test.js",
      "adapters/pi/test/tool-call-hook.test.js"
    ]
  },
  "mutate": [
    "engine/src/**/*.js",
    "adapters/codex/src/apply-patch-paths.js",
    "adapters/codex/src/execpolicy-rules.js",
    "adapters/codex/src/git-guard-adapter.js",
    "adapters/copilot/src/git-guard-adapter.js",
    "adapters/opencode/src/git-guard-adapter.js",
    "adapters/opencode/src/git-guard-predicate.js",
    "adapters/pi/src/tool-call-hook.js"
  ],
  "concurrency": 2,
  "tempDirName": "engine/.stryker-tmp",
  "reporters": ["clear-text", "progress"]
}
